# =============================================================================
# Dalala Marketplace – Production Environment Variables
# Copy to .env (local) or set in Vercel / your host. Never commit real values.
# =============================================================================

# --- Core / required for production ------------------------------------------
# Neon / Postgres connection string (required for durable data + auth sessions)
DATABASE_URL=postgresql://user:password@host:5432/dalala?sslmode=require

# Better Auth signing secret (min 32 random bytes, hex or base64)
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of this deployment (no trailing slash). Used for OAuth callbacks
# and absolute links.
BETTER_AUTH_URL=https://dalala.example.com

# Enable auth (must be "true" in production)
VITE_AUTH_ENABLED=true

# --- Grok Auth Broker (federated sign-in) ------------------------------------
# When deploying outside the Grok platform, either:
#   A) Point these at your own OIDC/OAuth broker, or
#   B) Switch to email/password only (see src/lib/auth/email-password.ts)
GROK_AUTH_ISSUER=https://auth.example.com
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# --- Optional / platform -----------------------------------------------------
# Set by Grok deploy platform; leave empty for self-hosted
# GROK_PROJECT_ID=

# Telegram bot (webhook + identity linking)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Analytics / observability (add as needed)
# SENTRY_DSN=
# POSTHOG_KEY=

# Node environment
NODE_ENV=production
